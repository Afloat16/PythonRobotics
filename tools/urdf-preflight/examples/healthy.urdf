<?xml version="1.0"?>
<robot name="inspection_arm" version="1.2">
  <link name="world"/>
  <link name="arm">
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="2"/>
      <inertia ixx="0.0166666666667" iyy="0.0166666666667" izz="0.0033333333333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.1 0.1 0.3"/></geometry></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.1 0.1 0.3"/></geometry></collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="world"/><child link="arm"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="12" velocity="1" acceleration="2"/>
  </joint>
</robot>
